# Docker Compose overrides.
#
# Base configuration comes from .env.
# This file only changes addresses that must resolve through the Docker
# Compose network instead of localhost.

# --- postgres --------------------------------------------------------------
POSTGRES_DSN=postgres://identity_app:devpassword@postgres:5432/identity?sslmode=disable

# --- redis -----------------------------------------------------------------
REDIS_ADDR=redis:6379

# --- opentelemetry ---------------------------------------------------------
# The API container reaches the OTel Collector through the shared Docker
# network using the collector service name.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317